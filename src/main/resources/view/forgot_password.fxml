<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.controller.ForgotPasswordController"
      spacing="14" styleClass="card" style="-fx-padding:24;">
    <Label text="%forgotPasswordTitle" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
    <Label text="%forgotPasswordBlurb" wrapText="true" maxWidth="420" styleClass="muted-text"/>
    <TextField fx:id="txtLoginId" promptText="%loginIdentifier" maxWidth="Infinity"/>
    <HBox spacing="10">
        <Button text="%generateOtp" defaultButton="true" onAction="#handleGenerate" styleClass="primary-btn"/>
        <Button text="%cancel" onAction="#handleClose" cancelButton="true"/>
    </HBox>
    <Label fx:id="lblMessage" style="-fx-text-fill:#c0392b;" wrapText="true" maxWidth="420"/>
</VBox>
