<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.AdminDashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background:#eef2f7;"
            stylesheets="@../style/app.css">

    <content>

        <VBox spacing="25" style="-fx-padding:30;" minWidth="0" maxWidth="Infinity">

            <!-- ================= GLOBAL STAT CARDS ================= -->
            <FlowPane hgap="20" vgap="20" prefWrapLength="1000" minWidth="0" maxWidth="Infinity">

                <VBox fx:id="cardDashTotal" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%TotalTickets" styleClass="muted-text"/>
                    <Label fx:id="lblTotalTickets" styleClass="stat-number"/>
                </VBox>

                <VBox fx:id="cardDashOpen" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%Open" styleClass="muted-text"/>
                    <Label fx:id="lblOpenTickets"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#f97316;"/>
                </VBox>

                <VBox fx:id="cardDashAssigned" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%Assigned" styleClass="muted-text"/>
                    <Label fx:id="lblAssignedTickets"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#eab308;"/>
                </VBox>

                <VBox fx:id="cardDashClosed" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%Closed" styleClass="muted-text"/>
                    <Label fx:id="lblClosedTickets"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#22c55e;"/>
                </VBox>

                <VBox fx:id="cardDashInsp" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%inspecteurs" styleClass="muted-text"/>
                    <Label fx:id="lblInspecteurCount"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#2563eb;"/>
                </VBox>

                <VBox fx:id="cardDashCtrl" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%controleurs" styleClass="muted-text"/>
                    <Label fx:id="lblControleurCount"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#1d4ed8;"/>
                </VBox>

                <VBox fx:id="cardDashVerif" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%verificateurs" styleClass="muted-text"/>
                    <Label fx:id="lblVerificateurCount"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0ea5e9;"/>
                </VBox>

                <VBox fx:id="cardDashAssist" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                    <Label text="%assistants" styleClass="muted-text"/>
                    <Label fx:id="lblAssistantCount"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#7c3aed;"/>
                </VBox>

            </FlowPane>

            <!-- ================= SLA & ESCALATION CARDS ================= -->
            <FlowPane hgap="20" vgap="20" prefWrapLength="1000" minWidth="0" maxWidth="Infinity">

                <VBox fx:id="cardDashSlaCompliance" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="250">
                    <Label text="%slaCompliance" styleClass="muted-text"/>
                    <Label fx:id="lblSlaCompliance"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#16a34a;"/>
                </VBox>

                <VBox fx:id="cardDashSlaBreaches" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="250">
                    <Label text="%SLABreaches" styleClass="muted-text"/>
                    <Label fx:id="lblSlaBreaches"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#dc2626;"/>
                </VBox>

                <VBox fx:id="cardDashEscalations" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="250">
                    <Label text="%escalations" styleClass="muted-text"/>
                    <Label fx:id="lblEscalations"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#7c3aed;"/>
                </VBox>

                <VBox fx:id="cardDashAvgResolution" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="250">
                    <Label text="%avgResolution" styleClass="muted-text"/>
                    <Label fx:id="lblAvgResolution"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0ea5e9;"/>
                </VBox>

                <VBox fx:id="cardDashTopAgent" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="250">
                    <Label text="%TopPerformingAgent" styleClass="muted-text"/>
                    <Label fx:id="lblTopAgent"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#9333ea;"/>
                </VBox>

            </FlowPane>

            <!-- ================= COURRIER (direction) ================= -->
            <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="card" style="-fx-padding:16;">
                <Label text="%courierBlockTitle" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                <FlowPane hgap="16" vgap="12" minWidth="0" maxWidth="Infinity" prefWrapLength="1000">
                    <VBox fx:id="cardCourierTotal" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                        <Label text="%courierDashInDirection" styleClass="muted-text"/>
                        <Label fx:id="lblCourierDTotal" styleClass="stat-number"/>
                    </VBox>
                    <VBox fx:id="cardCourierOpen" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                        <Label text="%courierDashOpenInDirection" styleClass="muted-text"/>
                        <Label fx:id="lblCourierDOpen" styleClass="stat-number"/>
                    </VBox>
                    <VBox fx:id="cardCourierAwaitSous" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="200">
                        <Label text="%courierDashAwaitSousInDirection" styleClass="muted-text"/>
                        <Label fx:id="lblCourierDAwaitSous" styleClass="stat-number"/>
                    </VBox>
                    <VBox fx:id="cardCourierResolved" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                        <Label text="%resolvedInDirection" styleClass="muted-text"/>
                        <Label fx:id="lblCourierDResolved" styleClass="stat-number"/>
                    </VBox>
                </FlowPane>
            </VBox>

            <!-- ================= CHART SECTION (wraps on narrow windows) ================= -->
            <FlowPane hgap="20" vgap="20" prefWrapLength="720" minWidth="0" maxWidth="Infinity">

                <VBox styleClass="card" minWidth="0" maxWidth="Infinity" prefWidth="500">
                    <Label text="%TicketDistribution" styleClass="title-medium"/>
                    <PieChart fx:id="ticketChart" minHeight="300" minWidth="0" maxWidth="Infinity"/>
                </VBox>

                <VBox styleClass="card" minWidth="0" maxWidth="Infinity" prefWidth="500">
                    <Label text="%SLAOverview" styleClass="title-medium"/>
                    <PieChart fx:id="slaChart" minHeight="300" minWidth="0" maxWidth="Infinity"/>
                </VBox>

            </FlowPane>

            <!-- ================= AGENT PERFORMANCE ================= -->
            <VBox styleClass="card" minWidth="0" maxWidth="Infinity">
                <Label text="%AgentPerformance" styleClass="title-medium"/>
                <BarChart fx:id="agentPerformanceChart"
                          categoryGap="20"
                          barGap="5"
                          minWidth="0"
                          maxWidth="Infinity"
                          minHeight="300">
                    <xAxis>
                        <CategoryAxis label="Agent"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Closed Tickets"/>
                    </yAxis>
                </BarChart>
            </VBox>


            <!-- ================= ADMIN ACTIONS ================= -->
<HBox spacing="10">

    

</HBox>


            <!-- ================= RECENT TICKETS TABLE ================= -->
            <VBox styleClass="card" minWidth="0" maxWidth="Infinity">
                <Label text="%RecentTickets" styleClass="title-medium"/>

                <TableView fx:id="recentTicketsTable" minWidth="0" maxWidth="Infinity" prefHeight="300">

                    <columns>
                        <TableColumn fx:id="colId" text="%ID"/>
                        <TableColumn fx:id="colTitle" text="%Title"/>
                        <TableColumn fx:id="colStatus" text="%Status"/>
                        <TableColumn fx:id="colCreated" text="%Created"/>
                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </content>

</ScrollPane>