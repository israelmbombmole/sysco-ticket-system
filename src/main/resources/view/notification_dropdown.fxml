<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.NotificationDropdownController"
      spacing="10"
      style="-fx-padding:15; -fx-background-color:white; -fx-border-color:#ddd; -fx-border-radius:6; -fx-background-radius:6;">

    <Label text="🔔Notifications"
           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

    <ListView fx:id="notificationList"
          prefHeight="280"
          prefWidth="330"/>

    <Button text="%ViewAllNotifications"
            fx:id="btnViewAll"/>
</VBox>