<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.ui.EditUserController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background:#eef2f7;">

    <content>

        <VBox spacing="20"
              alignment="TOP_CENTER"
              maxWidth="600"
              style="-fx-padding:25;">

    <!-- TITLE -->
    <Label text="%userFormTitle"
           style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#2c3e50;" />

    <!-- FORM CARD -->
    <VBox spacing="15"
          maxWidth="450"
          style="-fx-background-color:#f8f9fb; -fx-padding:20; -fx-background-radius:10; -fx-border-color:#e0e6ed;">

        <GridPane hgap="10" vgap="12">

            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <!-- Username -->
            <Label text="%userFormUsername" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtUsername"
                       promptText="%userFormUsernamePrompt"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Password (CREATE ONLY) -->
            <Label text="%userFormPassword" fx:id="lblPassword"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtPassword"
                           promptText="%userFormPasswordPrompt"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Role -->
            <Label text="%userFormRole" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbRole"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Email -->
            <Label text="%userFormEmailDirecteur" fx:id="lblEmail"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Active -->
            <Label text="%userFormActive" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <CheckBox fx:id="chkActive"
                      GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <!-- Sous Direction -->
            <Label text="%userFormSousDirection" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbSousDirection"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <!-- Direction -->
            <Label text="%userFormDirectionAutre" fx:id="lblDirection"
                   GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbDirection"
                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        </GridPane>

        <!-- ================= PERMISSIONS ================= -->
        <VBox spacing="8">

            <Label text="%userFormPermissions" style="-fx-font-weight:bold;"/>

            <Button text="%userFormSelectAll"
                    onAction="#handleSelectAll"
                    style="-fx-background-color:#3498db; -fx-text-fill:white;"/>

            <VBox spacing="5">

                <CheckBox fx:id="chkDashboard" text="%permDashboard"/>
                <CheckBox fx:id="chkDataEntry" text="%permDataEntry"/>
                <CheckBox fx:id="chkDataManagement" text="%permDataManagement"/>
                <CheckBox fx:id="chkDataShare" text="%permDataShare"/>
                <CheckBox fx:id="chkMyActivity" text="%permMyActivity"/>
                <CheckBox fx:id="chkTicketMonitoring" text="%permTicketMonitoring"/>
                <CheckBox fx:id="chkTicketManagement" text="%permTicketManagement"/>
                <CheckBox fx:id="chkFileShareManagement" text="%permFileShareManagement"/>
                <CheckBox fx:id="chkUserManagement" text="%permUserManagement"/>
                <CheckBox fx:id="chkLoginAudit" text="%permLoginAudit"/>
                <CheckBox fx:id="chkFileShareAudit" text="%permFileShareAudit"/>
                <CheckBox fx:id="chkCreateTicket" text="%permCreateTicket"/>
                <CheckBox fx:id="chkDirectionAssignment" text="%permDirectionAssignment"/>

            </VBox>

        </VBox>

        <!-- ACTION BUTTONS -->
        <HBox spacing="10" alignment="CENTER_RIGHT">

            <Button text="%userFormCancel"
                    onAction="#handleCancel"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

            <Button text="%userFormSave"
                    onAction="#handleSave"
                    style="-fx-background-color:#2ecc71; -fx-text-fill:white;"/>

        </HBox>

    </VBox>

        </VBox>

    </content>
</ScrollPane>
