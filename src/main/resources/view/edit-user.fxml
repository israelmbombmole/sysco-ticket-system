<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.ui.EditUserController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background:#eef2f7;">

    <content>

        <VBox spacing="20"
              alignment="TOP_CENTER"
              maxWidth="600"
              style="-fx-padding:25;">

    <!-- TITLE -->
    <Label text="%userForm"
           style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#2c3e50;" />

    <!-- FORM CARD -->
    <VBox spacing="15"
          maxWidth="450"
          style="-fx-background-color:#f8f9fb; -fx-padding:20; -fx-background-radius:10; -fx-border-color:#e0e6ed;">

        <GridPane hgap="10" vgap="12">

            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <!-- Username -->
            <Label text="%username" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtUsername"
                       promptText="%enterUsername"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Matricule -->
            <Label text="%matricule" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMatricule"
                       promptText="%enterMatricule"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Attendance / registry signature (MyShift) -->
            <Label text="%userAttendanceSignature" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtAttendanceSignature"
                       promptText="%userAttendanceSignaturePrompt"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Password (CREATE ONLY) -->
            <Label text="%password" fx:id="lblPassword"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <PasswordField fx:id="txtPassword"
                           promptText="%enterPassword"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Role -->
            <Label text="%role" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbRole"
                      GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <!-- Email -->
            <Label text="%email" fx:id="lblEmail"
                   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <!-- Active -->
            <Label text="%active" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <CheckBox fx:id="chkActive"
                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <!-- Direction -->
            <Label text="%direction" fx:id="lblDirection"
                   GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbDirection"
                      GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <!-- Sous Direction -->
            <Label text="%sousDirection" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbSousDirection"
                      GridPane.rowIndex="8" GridPane.columnIndex="1"/>

            <!-- Manual Sous Direction -->
            <Label text="%manualSousDirection" fx:id="lblCustomSousDirection"
                   GridPane.rowIndex="9" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCustomSousDirection"
                       promptText="%enterCustomSousDirection"
                       GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        </GridPane>

        <!-- ================= PERMISSIONS ================= -->
        <VBox spacing="8">

            <Label text="%permissions" style="-fx-font-weight:bold;"/>

            <Button text="%selectAll"
                    onAction="#handleSelectAll"
                    style="-fx-background-color:#3498db; -fx-text-fill:white;"/>

            <VBox fx:id="permissionsModuleBox" spacing="8"/>

        </VBox>

        <!-- ACTION BUTTONS -->
        <HBox spacing="10" alignment="CENTER_RIGHT">

            <Button text="%cancel"
                    onAction="#handleCancel"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

            <Button text="%save"
                    onAction="#handleSave"
                    style="-fx-background-color:#2ecc71; -fx-text-fill:white;"/>

        </HBox>

    </VBox>

        </VBox>

    </content>
</ScrollPane>