<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.InternalTicketEditController"
            style="-fx-background-color:#f8fafc;">

    <center>

        <VBox spacing="20"
              alignment="TOP_CENTER"
              style="-fx-padding:30;">

            <Label text="Edit Internal Ticket"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <VBox spacing="15"
                  maxWidth="500"
                  style="-fx-background-color:white;
                         -fx-padding:25;
                         -fx-background-radius:10;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.1),10,0,0,4);">

                <VBox spacing="5">
                    <Label text="Title"/>
                    <TextField fx:id="txtTitle"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Description"/>
                    <TextArea fx:id="txtDescription"
                              prefRowCount="4"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Priority"/>
                    <ComboBox fx:id="cmbPriority"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Department"/>
                    <ComboBox fx:id="cmbDepartment"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_RIGHT">

                    <Button text="Cancel"
                            onAction="#handleCancel"
                            style="-fx-background-color:#e5e7eb;"/>

                    <Button text="Update Ticket"
                            onAction="#handleUpdate"
                            style="-fx-background-color:#2f80ed;
                                   -fx-text-fill:white;"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>