<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding:20; -fx-background-color:#f5f7fb;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.MyWorkController">

    <!-- TITLE -->
    <Label text="%myWork"
           style="-fx-font-size:22px; -fx-font-weight:bold;" />

    <!-- ================= TICKETS ================= -->
    <VBox spacing="10" style="-fx-background:white; -fx-padding:15; -fx-background-radius:10;">
        <Label text="%myWorkTickets" style="-fx-font-size:16px; -fx-font-weight:bold;" />

        <TableView fx:id="tableTickets" prefHeight="250">

            <columns>
                <TableColumn fx:id="colId" text="%columnId" prefWidth="60"/>
                <TableColumn fx:id="colTitle" text="%columnTitle" prefWidth="200"/>
                <TableColumn fx:id="colStatus" text="%columnStatus" prefWidth="120"/>
                <TableColumn fx:id="colPriority" text="%columnPriority" prefWidth="100"/>
                <TableColumn fx:id="colStart" text="%columnStart" prefWidth="150"/>
                <TableColumn fx:id="colClose" text="%columnClose" prefWidth="150"/>
                <TableColumn fx:id="colResolution" text="%columnDuration" prefWidth="120"/>
                <TableColumn fx:id="colAction" text="%columnAction" prefWidth="120"/>
            </columns>

        </TableView>
    </VBox>

    <!-- ================= TASKS ================= -->
    <VBox spacing="10" style="-fx-background:white; -fx-padding:15; -fx-background-radius:10;">
        <Label text="%myWorkTasks" style="-fx-font-size:16px; -fx-font-weight:bold;" />

        <TableView fx:id="tableTasks" prefHeight="300">

            <columns>
                <TableColumn fx:id="colTaskId" text="%columnId" prefWidth="60"/>
                <TableColumn fx:id="colTaskTitle" text="%columnTitle" prefWidth="220"/>
                <TableColumn fx:id="colTaskStatus" text="%columnStatus" prefWidth="120"/>
                <TableColumn fx:id="colTaskStart" text="%columnStart" prefWidth="150"/>
                <TableColumn fx:id="colTaskClose" text="%columnClose" prefWidth="150"/>
                <TableColumn fx:id="colTaskResolution" text="%columnDuration" prefWidth="120"/>
                <TableColumn fx:id="colTaskAction" text="%columnAction" prefWidth="200"/>
            </columns>

        </TableView>
    </VBox>

</VBox>
