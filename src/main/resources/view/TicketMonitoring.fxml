<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.TicketMonitoringController"
            styleClass="gov-page-bg">

    <center>

        <ScrollPane fitToWidth="true"
                    vbarPolicy="AS_NEEDED"
                    hbarPolicy="NEVER"
                    styleClass="gov-scroll-surface">

            <VBox spacing="20" style="-fx-padding:20;">

                <!-- ================= ASSIGN SECTION ================= -->
                <VBox spacing="10">

                    <Label text="%assignTicket"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <TableView fx:id="tableTickets"
                               prefHeight="160">

                        <columns>
                            <TableColumn fx:id="colTicketIdAssign" text="%ticketId"/>
                            <TableColumn fx:id="colTitleAssign" text="%title"/>
                            <TableColumn fx:id="colStatusAssign" text="%status"/>
                        </columns>

                    </TableView>

                    <HBox spacing="10">

                        <VBox spacing="6">
                            <TextField fx:id="txtAgentSearch"
                                       promptText="Search user to assign..."
                                       prefWidth="200"/>
                            <!-- ✅ FIXED MULTI-SELECT LIST -->
                            <ListView fx:id="listAgents"
                                      prefHeight="100"
                                      prefWidth="200"/>
                        </VBox>

                        <Button text="%assign"
                                onAction="#handleAssign"
                                styleClass="primary-btn"/>

                    </HBox>

                </VBox>


                <!-- ================= ASSIGNMENTS TABLE ================= -->
                <VBox spacing="10">

                    <HBox spacing="10" alignment="CENTER_LEFT">

                        <Label text="%Recherche"
                               style="-fx-font-weight:bold;"/>

                        <TextField fx:id="txtSearch"
                                   promptText="Rechercher ID, agent ou statut..."
                                   HBox.hgrow="ALWAYS"/>

                    </HBox>

                    <Label text="%ticketAssignments"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <TableView fx:id="tableAssignments"
                               prefHeight="160">

                        <columns>
                            <TableColumn fx:id="colTicketIdAssigned" text="%ticketId" prefWidth="80"/>
                            <TableColumn fx:id="colAgentAssigned" text="%agent"/>
                            <TableColumn fx:id="colStatusAssigned" text="%status"/>
                        </columns>

                    </TableView>

                </VBox>

                <!-- ================= EXTERNAL ESCALATIONS ================= -->
                <VBox fx:id="externalEscalationsSection" spacing="10" managed="false" visible="false">
                    <Label text="%externalEscalations"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>
                    <TableView fx:id="tableExternalEscalations" prefHeight="180">
                        <columns>
                            <TableColumn fx:id="colExtTicket" text="%ticket"/>
                            <TableColumn fx:id="colExtFromDirection" text="%fromDirection"/>
                            <TableColumn fx:id="colExtToDirection" text="%toDirection"/>
                            <TableColumn fx:id="colExtSousDirection" text="%sousDirection"/>
                            <TableColumn fx:id="colExtStatus" text="%status"/>
                            <TableColumn fx:id="colExtAssignedTo" text="%assignedTo"/>
                            <TableColumn fx:id="colExtAction" text="%action"/>
                        </columns>
                    </TableView>
                </VBox>


                <!-- ================= STATS ================= -->
                <VBox spacing="10">

                    <Label text="%agentPerformanceStats"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <HBox spacing="20">

                        <TableView fx:id="tableStats"
                                   prefHeight="160"
                                   HBox.hgrow="ALWAYS">

                            <columns>
                                <TableColumn fx:id="colAgentName" text="%agent"/>
                                <TableColumn fx:id="colTotalTickets" text="%totalTickets"/>
                            </columns>

                        </TableView>

                        <PieChart fx:id="ticketPieChart"
                                  title="%ticketStatus"
                                  HBox.hgrow="ALWAYS"/>

                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>