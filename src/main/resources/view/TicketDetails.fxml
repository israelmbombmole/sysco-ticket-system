<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.app.controller.TicketDetailsController"
           style="-fx-background-color:#eef2f7;">

    <ScrollPane fitToWidth="true"
                vbarPolicy="AS_NEEDED"
                hbarPolicy="NEVER"
                style="-fx-background-color:transparent;">

        <VBox alignment="TOP_CENTER" minWidth="0" maxWidth="Infinity" spacing="20" style="-fx-padding:40;">

            <!-- EXPORT BUTTON -->
            <HBox spacing="10" alignment="CENTER_RIGHT" maxWidth="Infinity" minWidth="0">
                <Button text="%trackTicket"
                        onAction="#handleTrackTicket"
                        style="-fx-background-color:#2563eb;
                               -fx-text-fill:white;
                               -fx-padding:8 18;
                               -fx-font-weight:bold;
                               -fx-background-radius:6;"/>
                <Button text="%createJobFromTicket"
                        onAction="#handleCreateJobFromTicket"
                        style="-fx-background-color:#0ea5e9;
                               -fx-text-fill:white;
                               -fx-padding:8 18;
                               -fx-font-weight:bold;
                               -fx-background-radius:6;"/>
                <Button text="%ExportPDF"
                        onAction="#handleExportPDF"
                        style="-fx-background-color:#7c3aed;
                               -fx-text-fill:white;
                               -fx-padding:8 18;
                               -fx-font-weight:bold;
                               -fx-background-radius:6;"/>
            </HBox>

            <VBox fx:id="ticketContainer"
                  spacing="25"
                  minWidth="0"
                  maxWidth="Infinity"
                  style="-fx-background-color:white;
                         -fx-padding:35;
                         -fx-border-color:#d1d5db;
                         -fx-border-width:1;
                         -fx-border-radius:6;
                         -fx-background-radius:6;">

                <!-- HEADER -->
                <VBox spacing="8">
                    <Label fx:id="lblStatus"
                           style="-fx-font-size:13px;
                                  -fx-text-fill:#6b7280;
                                  -fx-font-weight:bold;"/>

                    <Label fx:id="lblReference"
                           style="-fx-font-size:14px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#374151;"/>

                    <Label fx:id="lblTitle"
                           style="-fx-font-size:22px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#111827;"/>

                    <HBox spacing="40">
                        <Label fx:id="lblCreatedBy"/>
                        <Label fx:id="lblUpdatedBy"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- INFORMATION -->
                <VBox spacing="15">
                    <Label text="%ticketInformation"
                           style="-fx-font-size:16px;
                                  -fx-font-weight:bold;"/>

                    <GridPane hgap="40" vgap="15">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="65"/>
                        </columnConstraints>

                        <Label text="%priority" GridPane.rowIndex="0"/>
                        <Label fx:id="lblPriority" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="%sla" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSla" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="%assignedAgent" GridPane.rowIndex="2"/>
                        <Label fx:id="lblAssigned" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="%startedAt" GridPane.rowIndex="3"/>
                        <Label fx:id="lblStarted" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="%closedAt" GridPane.rowIndex="4"/>
                        <Label fx:id="lblClosed" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="%resolution" GridPane.rowIndex="5"/>
                        <Label fx:id="lblResolution" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    </GridPane>
                </VBox>

                <Separator/>

                <!-- DESCRIPTION -->
                <VBox spacing="10">
                    <Label text="%description"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                    <TextArea fx:id="txtDescription"
                              editable="false"
                              wrapText="true"
                              prefRowCount="5"/>
                </VBox>

                <Separator/>

                <!-- TASKS -->
                <VBox spacing="10">

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="%tasks"
                               style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                        <Button text="%addTaskBtn"
                                onAction="#handleAddTask"
                                style="-fx-background-color:#10b981;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;"/>
                    </HBox>

                    <TreeTableView fx:id="taskTree" prefHeight="250">

                        <columns>
                            <TreeTableColumn fx:id="colTask" text="%task" prefWidth="350"/>
                            <TreeTableColumn fx:id="colUser" text="%assignedTo" prefWidth="200"/>
                            <TreeTableColumn fx:id="colStatus" text="%status" prefWidth="120"/>
                            <TreeTableColumn fx:id="colStart" text="%start"/>
                            <TreeTableColumn fx:id="colClose" text="%close"/>
                            <TreeTableColumn fx:id="colDuration" text="%duration"/>
                        </columns>

                    </TreeTableView>

                </VBox>

                <Separator/>

                <!-- ATTACHMENTS -->
                <VBox fx:id="attachmentFrame"
                      spacing="12"
                      visible="false"
                      managed="false">

                    <Label text="%attachments" style="-fx-font-weight:bold;"/>
                    <ListView fx:id="attachmentList" prefHeight="140"/>

                    <ImageView fx:id="attachmentImage"
                               fitWidth="450"
                               preserveRatio="true"
                               visible="false"
                               managed="false"/>
                </VBox>

                <Separator/>

                <!-- ACTIVITY -->
                <VBox spacing="10">

                    <Label text="%activityComments"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <ScrollPane fitToWidth="true" prefHeight="200">
                        <VBox fx:id="timelineContainer" spacing="10"/>
                    </ScrollPane>

                    <HBox spacing="10">
                        <TextField fx:id="txtNewComment"
                                   HBox.hgrow="ALWAYS"
                                   promptText="%writeComment"
                                   onAction="#handleAddComment"/>

                        <Button text="%add"
                                onAction="#handleAddComment"/>
                    </HBox>

                </VBox>

            </VBox>

        </VBox>

    </ScrollPane>

</StackPane>