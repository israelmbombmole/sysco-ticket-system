<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.app.controller.AddTaskPopupController"
      prefWidth="380" prefHeight="400"
      style="-fx-padding: 20; -fx-background-color: white;">

    <!-- TITLE -->
    <Label text="%addTaskTitle"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <!-- TASK TITLE -->
    <TextField fx:id="txtTaskTitle"
               promptText="%addTaskTitlePrompt"
               prefWidth="300"/>

    <!-- DESCRIPTION -->
    <TextArea fx:id="txtDescription"
              promptText="%addTaskDescriptionPrompt"
              prefWidth="300"
              prefHeight="80"
              wrapText="true"/>

    <!-- AGENT -->
    <ComboBox fx:id="cmbAgents"
              promptText="%addTaskSelectAgent"
              prefWidth="300"/>

    <!-- ATTACHMENTS FRAME (🔥 IMPORTANT FIX) -->
    <VBox fx:id="attachmentFrame"
          spacing="8"
          style="-fx-background-color:#f8fafc; -fx-padding:10; -fx-background-radius:8;">

        <Label text="%attachmentsLabel"
               style="-fx-font-weight:bold;" />

        <HBox spacing="15" alignment="CENTER_LEFT">

    <!-- LABEL -->
    <Label text="%attachmentsLabel"
           prefWidth="90"/>

    <!-- LIST -->
    <ListView fx:id="attachmentList"
              prefHeight="100"
              prefWidth="200"/>

    <!-- BUTTONS -->
    <VBox spacing="10">

        <Button text="%browse"
                onAction="#handleBrowseFiles"
                style="-fx-background-color:#2f80ed; -fx-text-fill:white; -fx-background-radius:8;"/>

        <Button text="%removeFile"
                onAction="#handleRemoveFile"
                style="-fx-background-color:#ef4444; -fx-text-fill:white; -fx-background-radius:8;"/>

    </VBox>

</HBox>

    </VBox>

    <!-- ACTION BUTTONS -->
    <HBox spacing="12" alignment="CENTER">

        <Button text="%save"
                onAction="#handleSave"
                prefWidth="100"
                style="-fx-background-color:#2ecc71; -fx-text-fill:white;" />

        <Button text="%cancel"
                onAction="#handleCancel"
                prefWidth="100"
                style="-fx-background-color:#e74c3c; -fx-text-fill:white;" />

    </HBox>

</VBox>
