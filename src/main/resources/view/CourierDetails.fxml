<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.app.controller.CourierDetailsController"
           style="-fx-background-color:#eef2f7;">

    <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                style="-fx-background-color:transparent;">
        <VBox alignment="TOP_CENTER" minWidth="0" maxWidth="Infinity" spacing="16" style="-fx-padding:24 40 40 40;">

            <HBox spacing="12" alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0">
                <Button fx:id="btnBack" onAction="#handleBack" text="%backToCourierList"
                        styleClass="btn-inst-secondary" style="-fx-font-weight:bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnOpenAttachment" onAction="#handleOpenAttachment" text="%courierOpenAttachment"
                        visible="false" managed="false" styleClass="primary-btn" style="-fx-font-weight:bold;"/>
                <Button fx:id="btnOpenTicket" onAction="#handleOpenLinkedTicket" text="%courierOpenLinkedTicket"
                        visible="false" managed="false" styleClass="primary-btn" style="-fx-font-weight:bold;"/>
            </HBox>

            <VBox spacing="20" minWidth="0" maxWidth="800" style="-fx-background-color:white;
                 -fx-padding:28; -fx-border-color:#d1d5db; -fx-border-width:1; -fx-border-radius:6; -fx-background-radius:6;">

                <Label fx:id="lblHeader" text="%courierDetailsTitle" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#111827;"/>

                <VBox spacing="6">
                    <Label fx:id="lblStatus" style="-fx-text-fill:#6b7280; -fx-font-weight:bold; -fx-font-size:13px;"/>
                    <Label fx:id="lblRef" style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#374151;"/>
                    <Label fx:id="lblTitle" wrapText="true" style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#111827;"/>
                    <Label fx:id="lblMeta" wrapText="true" style="-fx-text-fill:#4b5563; -fx-font-size:13px;"/>
                </VBox>

                <Separator/>

                <VBox spacing="10">
                    <Label text="%courierInformation" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                    <GridPane hgap="32" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="140"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="200"/>
                        </columnConstraints>
                        <Label text="%priority" GridPane.rowIndex="0"/>
                        <Label fx:id="lblPriority" GridPane.rowIndex="0" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%direction" GridPane.rowIndex="1"/>
                        <Label fx:id="lblDirection" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%sousDirection" GridPane.rowIndex="2"/>
                        <Label fx:id="lblSous" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%courierExtraDirections" GridPane.rowIndex="3"/>
                        <Label fx:id="lblExtraDirections" GridPane.rowIndex="3" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%courierFieldSender" GridPane.rowIndex="4"/>
                        <Label fx:id="lblSender" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%courierFieldRegDate" GridPane.rowIndex="5"/>
                        <Label fx:id="lblRegDate" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%internalTicket" GridPane.rowIndex="6"/>
                        <Label fx:id="lblLinkedTicket" GridPane.rowIndex="6" GridPane.columnIndex="1" wrapText="true"/>
                        <Label text="%courierAssignees" GridPane.rowIndex="7"/>
                        <Label fx:id="lblAssignees" GridPane.rowIndex="7" GridPane.columnIndex="1" wrapText="true" style="-fx-text-fill:#374151;"/>
                    </GridPane>
                </VBox>

                <Separator/>

                <VBox spacing="8">
                    <Label text="%description" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                    <TextArea fx:id="txtDescription" editable="false" wrapText="true" prefRowCount="5" maxWidth="Infinity" style="-fx-background-insets:0;"/>
                </VBox>

                <Separator/>

                <VBox spacing="8" minWidth="0" maxWidth="Infinity">
                    <Label text="%courierWorkflowHint" wrapText="true" style="-fx-text-fill:#4b5563; -fx-font-size:12px;"/>
                </VBox>

                <Separator/>

                <VBox spacing="8" minWidth="0" maxWidth="Infinity">
                    <Label text="%courierJourney" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                    <ListView fx:id="listJourney" prefHeight="220" maxWidth="Infinity"/>
                </VBox>

            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
