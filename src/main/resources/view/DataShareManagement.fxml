<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.ui.DataShareManagementController"
            style="-fx-background-color:#f8fafc;">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="10" style="-fx-padding:15;">
            
            <Label text="%fileShareManagement"
                   style="-fx-font-size:20px; -fx-font-weight:bold;" />

            <HBox spacing="10" alignment="CENTER_LEFT">

                <Label text="%Search"/>

                <TextField fx:id="txtSearch"
                           promptText="%searchFiles"
                           prefWidth="250"/>

            </HBox>

            <HBox fx:id="adminSessionSettingsBox" spacing="10" alignment="CENTER_LEFT">
                <Label text="%fileShareMgmtOtpSession"/>
                <ComboBox fx:id="cmbSessionMinutes" prefWidth="90"/>
                <Button text="%fileShareMgmtOtpSessionSave" onAction="#handleSaveSessionMinutes"/>
            </HBox>

        </VBox>
    </top>


    <!-- ================= TABLE ================= -->
    <center>
        <VBox spacing="10" style="-fx-padding:15;">

            <VBox fx:id="otpRequestsPanel" spacing="8" visible="false" managed="false">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%fileShareMgmtOtpRequestsTitle"
                           style="-fx-font-size:14px; -fx-font-weight:bold;"/>
                    <Button text="%refresh" onAction="#handleRefreshOtpRequests"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%Search"/>
                    <TextField fx:id="txtSearchOtpRequests"
                               promptText="%fileShareMgmtOtpSearchPrompt"
                               prefWidth="280"/>
                </HBox>
                <TableView fx:id="tableOtpRequests" prefHeight="150" minHeight="100" maxHeight="240"/>
            </VBox>

            <TableView fx:id="tableFiles"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colFileName"
                                 text="%FileName"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colSharedBy"
                                 text="%SharedBy"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colRole"
                                 text="%Role"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colDate"
                                 text="%Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colTime"
                                 text="%Time"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>