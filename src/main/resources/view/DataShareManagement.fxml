<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.ui.DataShareManagementController"
            style="-fx-background-color:#f8fafc;">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="10" style="-fx-padding:15;">
            
            <Label text="%fileShareManagement"
                   style="-fx-font-size:20px; -fx-font-weight:bold;" />

            <HBox spacing="10" alignment="CENTER_LEFT">

                <Label text="%Search"/>

                <TextField fx:id="txtSearch"
                           promptText="%dataShareSearchFiles"
                           prefWidth="250"/>

            </HBox>

        </VBox>
    </top>


    <!-- ================= TABLE ================= -->
    <center>
        <VBox spacing="10" style="-fx-padding:15;">

            <TableView fx:id="tableFiles"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colFileName"
                                 text="%FileName"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colSharedBy"
                                 text="%SharedBy"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colRole"
                                 text="%Role"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colDate"
                                 text="%Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colTime"
                                 text="%Time"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>