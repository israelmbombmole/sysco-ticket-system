<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.app.controller.LoginController"
           style="-fx-background-color: linear-gradient(to right,#4b5cc4,#6a82fb);">

    <HBox alignment="CENTER" spacing="40" fillHeight="true"
          maxWidth="1100" StackPane.alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- ================= LOGIN CARD ================= -->

        <VBox spacing="20"
      alignment="CENTER"
      minWidth="300"
      prefWidth="420"
      maxWidth="520"
      style="
             -fx-background-color:white;
             -fx-background-radius:30;
             -fx-border-radius:30;
             -fx-padding:40;
             -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.25),20,0,0,10);
      ">

            <!-- SYSTEM TITLE -->

            <Label text="%appName"
                   style="-fx-font-size:32px;
                          -fx-font-weight:bold;
                          -fx-text-fill:#2c3e50;"/>

            <Label text="%loginUserTitle"
                   style="-fx-font-size:16px;
                          -fx-text-fill:#555;"/>

            <!-- USERNAME -->

            <TextField fx:id="txtUsername"
                       promptText="%loginUsernamePrompt"
                       maxWidth="Infinity"
                       style="
                              -fx-background-radius:8;
                              -fx-padding:10;
                       "/>

            <!-- PASSWORD -->

            <PasswordField fx:id="txtPassword"
                           promptText="%loginPasswordPrompt"
                           maxWidth="Infinity"
                           style="
                                  -fx-background-radius:8;
                                  -fx-padding:10;
                           "/>

            <!-- LOGIN BUTTON -->

            <Button fx:id="btnLogin"
                    text="%loginButton"
                    defaultButton="true"
                    maxWidth="Infinity"
                    onAction="#handleLogin"
                    style="
                           -fx-background-color:#5b73d1;
                           -fx-text-fill:white;
                           -fx-font-size:14px;
                           -fx-background-radius:10;
                    "/>

            <!-- PROGRESS BAR -->

            <ProgressBar fx:id="progressBar"
                         maxWidth="Infinity"
                         visible="false"
                         progress="0"/>

            <!-- MESSAGE -->

            <Label fx:id="lblMessage"
                   style="-fx-text-fill:red;
                          -fx-font-size:12px;"/>

            <!-- LANGUAGE TOGGLE -->
            <HBox spacing="8" alignment="CENTER">
                <Button text="%langEnglish"
                        onAction="#handleEnglish"
                        style="-fx-background-color:#e2e8f0; -fx-text-fill:#1f2937; -fx-background-radius:8; -fx-padding:4 12;"/>
                <Button text="%langFrench"
                        onAction="#handleFrench"
                        style="-fx-background-color:#e2e8f0; -fx-text-fill:#1f2937; -fx-background-radius:8; -fx-padding:4 12;"/>
            </HBox>

        </VBox>


        <!-- ================= RIGHT PANEL ================= -->

        <StackPane minWidth="260" prefWidth="500" HBox.hgrow="ALWAYS">

            <VBox alignment="CENTER" spacing="20">

                <!-- DGDA LOGO (NOT ROUNDED) -->

                <ImageView fitHeight="180"
                           preserveRatio="true">

                    <image>
                        <Image url="@/images/dgda.png"/>
                    </image>

                </ImageView>

                <Label text="%loginFooterDgda"
                       style="
                              -fx-font-size:22px;
                              -fx-font-weight:bold;
                              -fx-text-fill:white;
                              -fx-wrap-text:true;
                              -fx-text-alignment:center;
                       "/>

                <Label text="%loginFooterDsti"
                       style="
                              -fx-font-size:16px;
                              -fx-text-fill:white;
                              -fx-wrap-text:true;
                              -fx-text-alignment:center;
                       "/>
                
                <Label text="%loginFooterSdma"
                       style="
                              -fx-font-size:14px;
                              -fx-text-fill:white;
                              -fx-wrap-text:true;
                              -fx-text-alignment:center;
                       "/>
                
                

                <Label text="%loginLegalNotice"
       wrapText="true"
       maxWidth="420"
       style="
              -fx-text-fill:white;
              -fx-font-size:12px;
              -fx-text-alignment:center;
       "/>

            </VBox>

        </StackPane>

    </HBox>

</StackPane>