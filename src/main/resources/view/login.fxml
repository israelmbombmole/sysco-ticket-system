<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.app.controller.LoginController"
           style="-fx-background-color: linear-gradient(to right,#4b5cc4,#6a82fb);">

    <HBox alignment="CENTER" spacing="40" fillHeight="true"
          maxWidth="1100" StackPane.alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- ================= LOGIN CARD ================= -->

        <VBox spacing="20"
      alignment="CENTER"
      minWidth="300"
      prefWidth="420"
      maxWidth="520"
      style="
             -fx-background-color:white;
             -fx-background-radius:30;
             -fx-border-radius:30;
             -fx-padding:40;
             -fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.25),20,0,0,10);
      ">

            <!-- SYSTEM TITLE -->

            <Label text="SYSCO"
                   style="-fx-font-size:32px;
                          -fx-font-weight:bold;
                          -fx-text-fill:#2c3e50;"/>

            <Label text="Connexion utilisateur"
                   style="-fx-font-size:16px;
                          -fx-text-fill:#555;"/>

            <!-- USERNAME -->

            <TextField fx:id="txtUsername"
                       promptText="Nom d'utilisateur"
                       maxWidth="Infinity"
                       style="
                              -fx-background-radius:8;
                              -fx-padding:10;
                       "/>

            <!-- PASSWORD -->

            <PasswordField fx:id="txtPassword"
                           promptText="Mot de passe"
                           maxWidth="Infinity"
                           style="
                                  -fx-background-radius:8;
                                  -fx-padding:10;
                           "/>

            <!-- LOGIN BUTTON -->

            <Button fx:id="btnLogin"
                    text="SE CONNECTER"
                    defaultButton="true"
                    maxWidth="Infinity"
                    onAction="#handleLogin"
                    style="
                           -fx-background-color:#5b73d1;
                           -fx-text-fill:white;
                           -fx-font-size:14px;
                           -fx-background-radius:10;
                    "/>

            <!-- PROGRESS BAR -->

            <ProgressBar fx:id="progressBar"
                         maxWidth="Infinity"
                         visible="false"
                         progress="0"/>

            <!-- MESSAGE -->

            <Label fx:id="lblMessage"
                   style="-fx-text-fill:red;
                          -fx-font-size:12px;"/>

        </VBox>


        <!-- ================= RIGHT PANEL ================= -->

        <StackPane minWidth="260" prefWidth="500" HBox.hgrow="ALWAYS">

            <VBox alignment="CENTER" spacing="20">

                <!-- DGDA LOGO (NOT ROUNDED) -->

                <ImageView fitHeight="180"
                           preserveRatio="true">

                    <image>
                        <Image url="@/images/dgda.png"/>
                    </image>

                </ImageView>

                <Label text="Direction Générale des Douanes et Accises"
                       style="
                              -fx-font-size:22px;
                              -fx-font-weight:bold;
                              -fx-text-fill:white;
                              -fx-wrap-text:true;
                              -fx-text-alignment:center;
                       "/>

                <Label text="Direction des Systèmes et Technologies d’Information"
                       style="
                              -fx-font-size:16px;
                              -fx-text-fill:white;
                              -fx-wrap-text:true;
                              -fx-text-alignment:center;
                       "/>
                
                <Label text="Sous-direction de Maintenance et Application (SDMA)"
                       style="
                              -fx-font-size:14px;
                              -fx-text-fill:white;
                              -fx-wrap-text:true;
                              -fx-text-alignment:center;
                       "/>
                
                

                <Label text="Ce système est réservé aux utilisateurs autorisés. Toutes les activités sont surveillées et enregistrées. Tout accès non autorisé ou toute utilisation abusive peut entraîner des sanctions disciplinaires, voire des poursuites judiciaires. En vous connectant, vous consentez à cette surveillance."
       wrapText="true"
       maxWidth="420"
       style="
              -fx-text-fill:white;
              -fx-font-size:12px;
              -fx-text-alignment:center;
       "/>

            </VBox>

        </StackPane>

    </HBox>

</StackPane>