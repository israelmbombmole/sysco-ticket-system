<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.app.controller.TaskDetailsController"
           style="-fx-background-color:#eef2f7;">

    <!-- ✅ GLOBAL SCROLL -->
    <ScrollPane fitToWidth="true"
                vbarPolicy="AS_NEEDED"
                hbarPolicy="NEVER"
                style="-fx-background-color:transparent;">

        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding:30;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="%back"
                        onAction="#handleBack"
                        style="-fx-background-color:#6b7280; -fx-text-fill:white;"/>
                <Button text="%trackTask"
                        onAction="#handleTrackTask"
                        style="-fx-background-color:#2563eb; -fx-text-fill:white;"/>
                <Button text="%ExportPDF"
                        onAction="#handleExportPDF"
                        style="-fx-background-color:#7c3aed; -fx-text-fill:white;"/>
            </HBox>

            <VBox fx:id="taskContainer" spacing="20"
                  maxWidth="800"
                  fillWidth="true"
                  style="-fx-background-color:white;
                         -fx-padding:30;
                         -fx-border-color:#d1d5db;
                         -fx-border-radius:8;
                         -fx-background-radius:8;">

                <!-- HEADER -->
                <Label fx:id="lblTitle"
                       style="-fx-font-size:20px; -fx-font-weight:bold;"/>

                <Label fx:id="lblAssigned"/>

                <!-- STATUS -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%status"/>
                    <ComboBox fx:id="cmbStatus" prefWidth="200"/>
                </HBox>

                <!-- PROGRESS -->
                <VBox spacing="5">
                    <Label text="%progress"/>
                    <Slider fx:id="sliderProgress" min="0" max="100"/>
                    <Label fx:id="lblProgress"/>
                </VBox>

                <!-- DESCRIPTION -->
                <VBox spacing="5">
                    <Label text="%description"/>
                    <TextArea fx:id="txtDescription"
                              prefRowCount="4"
                              wrapText="true"/>
                </VBox>

                <!-- ATTACHMENTS -->
                <VBox spacing="10">

                    <Label text="%attachments"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <HBox spacing="15">

                        <!-- FILE LIST -->
                        <ListView fx:id="attachmentList"
                                  prefWidth="260"
                                  prefHeight="200"/>

                        <!-- PREVIEW + ACTIONS -->
                        <VBox spacing="10">

                            <StackPane fx:id="previewContainer"
                                       prefWidth="400"
                                       prefHeight="200"
                                       style="-fx-background-color:#f3f4f6; -fx-padding:10; -fx-background-radius:6;">

                                <Label fx:id="lblPreviewPlaceholder"
                                       text="%selectFilePreview"
                                       style="-fx-text-fill:gray;"/>
                            </StackPane>

                            <!-- ACTION BUTTONS -->
                            <HBox spacing="10" alignment="CENTER">

                                <Button text="%button.open"
                                        onAction="#handleOpenAttachment"
                                        style="-fx-background-color:#3b82f6; -fx-text-fill:white;"/>

                                <Button text="%download"
                                        onAction="#handleDownloadAttachment"
                                        style="-fx-background-color:#10b981; -fx-text-fill:white;"/>

                            </HBox>

                        </VBox>

                    </HBox>

                </VBox>

                <!-- 🔥 TASK LIST (NEW SECTION) -->
                <VBox spacing="10">

                    <Label text="%tasks"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <TableView fx:id="tableTasks" prefHeight="200">

                        <columns>
                            <TableColumn fx:id="colTitle" text="%title"/>
                            <TableColumn fx:id="colAssigned" text="%assignedTo"/>
                            <TableColumn fx:id="colAssignedAt" text="%assignedAt"/>
                            <TableColumn fx:id="colStatus" text="%status"/>
                        </columns>

                    </TableView>

                </VBox>
                
                <!-- 🔥 ESCALATIONS -->
                <VBox spacing="10">

                    <Label text="%escalations"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <VBox fx:id="escalationBox"
                          spacing="8"
                          style="-fx-background-color:#fff7ed;
                                 -fx-padding:10;
                                 -fx-background-radius:6;
                                 -fx-border-color:#fed7aa;
                                 -fx-border-radius:6;">

                        <Label fx:id="lblNoEscalation"
                               text="%noEscalation"
                               style="-fx-text-fill:gray;"/>

                    </VBox>

                </VBox>

                <!-- ACTIVITY / COMMENTS -->
                <VBox spacing="10">

                    <Label text="%activityComments"
                           style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                    <ScrollPane fitToWidth="true"
                                prefHeight="400"
                                vbarPolicy="AS_NEEDED"
                                style="-fx-background:#f9fafb; -fx-background-radius:6;">

                        <VBox fx:id="timelineContainer"
                              spacing="12"
                              style="-fx-padding:10;"/>
                    </ScrollPane>

                    <HBox spacing="10">

                        <TextField fx:id="txtNewComment"
                                   HBox.hgrow="ALWAYS"
                                   promptText="%writeComment"
                                   onAction="#handleAddComment"/>

                        <Button text="%add"
                                onAction="#handleAddComment"
                                style="-fx-background-color:#3b82f6; -fx-text-fill:white;"/>

                    </HBox>

                </VBox>

            </VBox>

        </VBox>

    </ScrollPane>

</StackPane>