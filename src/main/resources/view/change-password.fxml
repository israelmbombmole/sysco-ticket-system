<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.controller.ChangePasswordController"
      spacing="15"
      alignment="CENTER"
      style="-fx-padding:25; -fx-background-color:white;">

    <Label text="Change Password"
           style="-fx-font-size:18px; -fx-font-weight:bold;" />

    <PasswordField fx:id="txtNewPassword"
                   promptText="New Password"
                   prefWidth="250"/>

    <PasswordField fx:id="txtConfirmPassword"
                   promptText="Confirm Password"
                   prefWidth="250"/>

    <Button text="Save"
            onAction="#handleSave"
            style="-fx-background-color:#4CAF50; -fx-text-fill:white;"/>

    <Label fx:id="lblMessage"
           style="-fx-text-fill:red;"/>

</VBox>