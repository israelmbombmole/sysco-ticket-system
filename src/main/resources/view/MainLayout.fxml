<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           maxWidth="Infinity"
           maxHeight="Infinity"
           fx:controller="com.app.controller.MainController"
           stylesheets="@../style/app.css">

    <BorderPane fx:id="rootPane" maxWidth="Infinity" maxHeight="Infinity">

        <!-- HEADER -->
        <top>
            <HBox styleClass="top-bar" alignment="CENTER_LEFT">
                <ImageView fitWidth="34" fitHeight="34" preserveRatio="true">
                    <image>
                        <Image url="file:/C:/Users/Israe/.cursor/projects/c-sqlite-javafx-audit-system/assets/c__Users_Israe_AppData_Roaming_Cursor_User_workspaceStorage_7305834def579094771d21ca3ae571c5_images_Gemini_Generated_Image_rqnoiarqnoiarqno-a954d1ba-756d-40e2-a967-e7455c751e2e.png"/>
                    </image>
                </ImageView>
                <Label text="%appTitle"/>
                <Pane HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblUser"
                       style="-fx-text-fill:white; -fx-font-size:14px;"/>
                <Button fx:id="btnNotifications"
                        onAction="#openNotifications"
                        contentDisplay="GRAPHIC_ONLY"
                        styleClass="header-notif-btn"
                        focusTraversable="false"
                        minWidth="36" minHeight="36" prefWidth="40" prefHeight="36">
                    <graphic>
                        <StackPane>
                            <Label text="&#128276;" styleClass="header-bell-glyph" mouseTransparent="true"/>
                            <Label fx:id="badgeNotifications"
                                   text=""
                                   visible="false"
                                   mouseTransparent="true"
                                   StackPane.alignment="TOP_RIGHT"
                                   style="-fx-background-color:#c42b2b; -fx-text-fill:white; -fx-padding:0 5 0 5; -fx-min-width:16; -fx-alignment:center; -fx-background-radius:8; -fx-font-size:9px;">
                                <StackPane.margin>
                                    <Insets top="-4" right="-2"/>
                                </StackPane.margin>
                            </Label>
                        </StackPane>
                    </graphic>
                </Button>
                <!-- LANGUAGE FLAGS -->
               <Button onAction="#switchToEnglish"
        style="-fx-background-color:transparent; -fx-cursor:hand;">

    <graphic>
        <ImageView fitWidth="22" fitHeight="22">
            <image>
                <Image url="@/images/en.png"/>
            </image>
        </ImageView>
    </graphic>

</Button>

               <Button onAction="#switchToFrench"
        style="-fx-background-color:transparent; -fx-cursor:hand;">

    <graphic>
        <ImageView fitWidth="22" fitHeight="22">
            <image>
                <Image url="@/images/fr.png"/>
            </image>
        </ImageView>
    </graphic>

</Button>
                
                
            </HBox>
        </top>

        <!-- SIDEBAR: scroll menu + fixed logout (no giant empty filler above Déconnexion) -->
        <left>
            <BorderPane minWidth="170" maxWidth="280" prefWidth="220" style="-fx-background-color:#0a1624;">
            <center>
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="sidebar-scroll"
                        maxWidth="Infinity"
                        maxHeight="Infinity"
                        BorderPane.alignment="TOP_LEFT">

            <VBox fx:id="sidebar"
                  styleClass="sidebar"
                  spacing="12"
                  minWidth="170"
                  prefWidth="220"
                  maxWidth="260">

                <Button fx:id="btnDashboard"
                        text="%dashboard"
                        onAction="#loadDashboard"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnDataEntry"
                        text="%dataEntry"
                        onAction="#loadDataEntry"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnCouriers"
                        text="%courierModule"
                        onAction="#openCouriers"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnCourierManagement"
                        text="%courierManagementModule"
                        onAction="#openCourierManagement"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnDataManagement"
                        text="%dataManagement"
                        onAction="#loadDataManagement"
                        styleClass="sidebar-btn"/>
               
                <Button fx:id="btnDataShare"
                        text="%dataShare"
                        onAction="#openDataShare"
                        styleClass="sidebar-btn"/>
                
                <Button fx:id="btnMyActivity"
                        text="%myActivity"
                        onAction="#openMyActivity"
                        styleClass="sidebar-btn"/>
                
                <Button fx:id="btnMyWork"
                        text="%myWork"
                        onAction="#loadMyWork"
                        styleClass="sidebar-btn"/>
                

                <Button fx:id="btnTicketMonitoring"
                        text="%ticketMonitoring"
                        onAction="#loadTicketMonitoring"
                        styleClass="sidebar-btn"/>
                
                <Button fx:id="btnTicketManagement"
                        text="%ticketManagement"
                        onAction="#openTicketManagement"
                        styleClass="sidebar-btn"/>
                
                <Button fx:id="btnFileShareManagement"
                        text="%fileShareManagement"
                        onAction="#handleDataShareManagement"
                        styleClass="sidebar-btn"/>
                
                
                <Button fx:id="btnUserManagement"
                        text="%userManagement"
                        onAction="#loadUserManagement"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnLeaveManagement"
                        text="%leaveManagement"
                        onAction="#openLeaveManagement"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnLoginAudit"
                        text="%loginAudit"
                        onAction="#loadLoginAudit"
                        styleClass="sidebar-btn"/>
                
                <Button fx:id="btnFileShareAudit"
                        text="%fileShareAudit"
                        onAction="#loadFileShareAudit"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnCreateTicket"
                text="%createTicket"
                onAction="#openCreateTicket"
                styleClass="sidebar-btn"/>

                <Button fx:id="btnJobScheduler"
                        text="%jobScheduler"
                        onAction="#openJobScheduler"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnMissions"
                        text="%missions"
                        onAction="#openMissions"
                        styleClass="sidebar-btn"/>

                <Button fx:id="btnMyShift"
                        text="%myshiftModule"
                        onAction="#openMyShift"
                        styleClass="sidebar-btn"/>

            </VBox>
            </ScrollPane>
            </center>
            <bottom>
                <VBox styleClass="sidebar" alignment="CENTER" minWidth="170" prefWidth="220" maxWidth="260" style="-fx-padding:0 16 16 16;">
                    <Button fx:id="btnLogout"
                            text="%logout"
                            onAction="#handleLogout"
                            maxWidth="Infinity"
                            styleClass="danger-btn"/>
                </VBox>
            </bottom>
            </BorderPane>
        </left>

        <!-- CONTENT -->
        <center>
            <StackPane styleClass="main-center-wrap" maxWidth="Infinity" maxHeight="Infinity">
                <StackPane fx:id="contentArea"
                           styleClass="main-content-surface"
                           maxWidth="Infinity"
                           maxHeight="Infinity"
                           StackPane.alignment="CENTER"/>
            </StackPane>
        </center>

    </BorderPane>

    <!-- FLOATING CHAT BUTTON -->
    <Button fx:id="btnChat"
            onAction="#openChat"
            styleClass="floating-chat"
            StackPane.alignment="BOTTOM_RIGHT">

        <graphic>
            <Label text="💬"
                   style="-fx-font-size:18px;"/>
        </graphic>

        <StackPane.margin>
            <Insets right="25" bottom="25"/>
        </StackPane.margin>

    </Button>

</StackPane>