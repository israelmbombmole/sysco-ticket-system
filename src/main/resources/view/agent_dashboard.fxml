<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.AgentDashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="gov-work-page"
            style="-fx-background:transparent;"
            stylesheets="@../style/app.css">

    <content>

        <VBox spacing="15" style="-fx-padding:20;" minWidth="0" maxWidth="Infinity">

            <Label text="%agent_dashboard"
                   style="-fx-font-size:20px; -fx-font-weight:bold;" />

            <!-- ================= STAT CARDS ================= -->
            <FlowPane hgap="20" vgap="20" minWidth="0" maxWidth="Infinity" prefWrapLength="1200">

                <VBox fx:id="cardAgentTotal" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                    <Label text="%total"/>
                    <Label fx:id="lblTotal"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox fx:id="cardAgentOpen" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                    <Label text="%open"/>
                    <Label fx:id="lblOpen"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox fx:id="cardAgentInProgress" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                    <Label text="%inProgress"/>
                    <Label fx:id="lblInProgress"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox fx:id="cardAgentMerged" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                    <Label text="%MergeTicket"/>
                    <Label fx:id="lblMerged"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox fx:id="cardAgentClosed" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                    <Label text="%closed"/>
                    <Label fx:id="lblClosed"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

            </FlowPane>


            <!-- ================= PIE CHART ================= -->
            <VBox styleClass="card" managed="false" visible="false">

                <Label text="%ticketDistribution"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <PieChart fx:id="pieChart"
                          minWidth="0"
                          maxWidth="Infinity"
                          minHeight="280"/>

            </VBox>


            <!-- ================= SLA OVERVIEW ================= -->
            <VBox styleClass="card">

                <Label text="%SLAOverview"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <FlowPane hgap="20" vgap="15" minWidth="0" maxWidth="Infinity" prefWrapLength="800">

                    <VBox fx:id="cardAgentSlaBreaches" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                        <Label text="%SLABreaches"/>
                        <Label fx:id="lblSlaBreaches"
                               style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>

                    <VBox fx:id="cardAgentEscalations" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                        <Label text="%escalations"/>
                        <Label fx:id="lblEscalations"
                               style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>

                    <VBox fx:id="cardAgentSlaCompliance" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="180">
                        <Label text="%slaCompliance"/>
                        <Label fx:id="lblSlaCompliance"
                               style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>

                </FlowPane>

            </VBox>

            <!-- Courrier (sous-direction) -->
            <VBox spacing="12" minWidth="0" maxWidth="Infinity" styleClass="card" style="-fx-padding:12;">
                <Label text="%courierBlockSousTitle" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
                <FlowPane hgap="12" vgap="10" minWidth="0" maxWidth="Infinity" prefWrapLength="900">
                    <VBox fx:id="cardAgentCourierTotal" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="160">
                        <Label text="%courierDashSousTotal" styleClass="muted-text"/>
                        <Label fx:id="lblCourierSTotal" style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox fx:id="cardAgentCourierOpen" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="160">
                        <Label text="%courierDashSousOpen" styleClass="muted-text"/>
                        <Label fx:id="lblCourierSOpen" style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox fx:id="cardAgentCourierPipe" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="160">
                        <Label text="%courierDashSousPipeline" styleClass="muted-text"/>
                        <Label fx:id="lblCourierSPipe" style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox fx:id="cardAgentCourierResolved" styleClass="clickable-stat-card dashboard-stat-sq" minWidth="160">
                        <Label text="%resolved" styleClass="muted-text"/>
                        <Label fx:id="lblCourierSResolved" style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>
                </FlowPane>
            </VBox>

            <!-- ================= PERFORMANCE CHART ================= -->
            <VBox styleClass="card">

                <Label text="%AgentPerformance"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <LineChart fx:id="performanceChart"
                           minWidth="0"
                           maxWidth="Infinity"
                           minHeight="300">

                    <xAxis>
                        <CategoryAxis label="%date"/>
                    </xAxis>

                    <yAxis>
                        <NumberAxis label="%closedTickets"/>
                    </yAxis>

                </LineChart>

            </VBox>

        </VBox>

    </content>

</ScrollPane>