<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.controller.AgentDashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background-color:#f4f6f9;">

    <content>

        <HBox alignment="CENTER_RIGHT" spacing="10" fillHeight="true">

    <Label text="%agent_dashboard"
           style="-fx-font-size:20px; -fx-font-weight:bold;" />

    <Region HBox.hgrow="ALWAYS"/>

    <!-- 🔔 NOTIFICATION BUTTON -->
    <Button text="🔔"
            onAction="#openNotifications"
            style="-fx-font-size:16px;"/>

    <!-- 🔴 BADGE -->
    <Label fx:id="lblNotifCount"
           style="-fx-background-color:red;
                  -fx-text-fill:white;
                  -fx-padding:2 6;
                  -fx-background-radius:10;"/>

</HBox>
        
        
        <VBox spacing="15" style="-fx-padding:20;" maxWidth="Infinity">

            <!-- ================= TITLE ================= -->
            <Label text="%agent_dashboard"
                   style="-fx-font-size:20px; -fx-font-weight:bold;" />

            <!-- ================= STAT CARDS ================= -->
            <FlowPane hgap="20" vgap="20" prefWrapLength="900">

                <VBox styleClass="card" minWidth="180">
                    <Label text="%total"/>
                    <Label fx:id="lblTotal"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox styleClass="card" minWidth="180">
                    <Label text="%open"/>
                    <Label fx:id="lblOpen"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox styleClass="card" minWidth="180">
                    <Label text="%inProgress"/>
                    <Label fx:id="lblInProgress"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox styleClass="card" minWidth="180">
                    <Label text="%MergeTicket"/>
                    <Label fx:id="lblMerged"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

                <VBox styleClass="card" minWidth="180">
                    <Label text="%closed"/>
                    <Label fx:id="lblClosed"
                           style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

            </FlowPane>


            <!-- ================= PIE CHART ================= -->
            <VBox styleClass="card">

                <Label text="%ticketDistribution"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <PieChart fx:id="pieChart"
                          minHeight="280"/>

            </VBox>


            <!-- ================= SLA OVERVIEW ================= -->
            <VBox styleClass="card">

                <Label text="%SLAOverview"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <FlowPane hgap="20" vgap="15">

                    <VBox minWidth="180">
                        <Label text="%SLABreaches"/>
                        <Label fx:id="lblSlaBreaches"
                               style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>

                    <VBox minWidth="180">
                        <Label text="%escalations"/>
                        <Label fx:id="lblEscalations"
                               style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>

                    <VBox minWidth="180">
                        <Label text="%slaCompliance"/>
                        <Label fx:id="lblSlaCompliance"
                               style="-fx-font-size:20px; -fx-font-weight:bold;"/>
                    </VBox>

                </FlowPane>

            </VBox>


            <!-- ================= PERFORMANCE CHART ================= -->
            <VBox styleClass="card">

                <Label text="%AgentPerformance"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <LineChart fx:id="performanceChart"
                           title="%chartTicketsClosedPerDay"
                           minHeight="300">

                    <xAxis>
                        <CategoryAxis label="%date"/>
                    </xAxis>

                    <yAxis>
                        <NumberAxis label="%closedTickets"/>
                    </yAxis>

                </LineChart>

            </VBox>


            <!-- ================= TABLE ================= -->
            <VBox styleClass="card">

                <Label text="%myAssignedTickets"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">

                    <TextField fx:id="txtSearch"
                               promptText="%searchTickets"
                               prefWidth="260"
                               style="-fx-background-radius:6;
                                      -fx-border-radius:6;
                                      -fx-border-color:#d1d5db;" />

                </HBox>

                <TableView fx:id="tableTickets" minHeight="260" maxWidth="Infinity">

                    <columns>

                        <TableColumn fx:id="colTicketId" text="%id"/>
                        <TableColumn fx:id="colTitle" text="%title"/>
                        <TableColumn fx:id="colStatus" text="%status"/>
                        <TableColumn fx:id="colType" text="%Type"/>
                        <TableColumn fx:id="colStarted" text="%started"/>
                        <TableColumn fx:id="colClosed" text="%closed"/>
                        <TableColumn fx:id="colResolution" text="%resolution"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- ================= ACTION BUTTONS ================= -->
            <FlowPane hgap="15" vgap="10">

                <Button text="%startWork"
                        onAction="#handleStart"/>

                <Button text="%closeTicket"
                        onAction="#handleClose"/>

                <Button text="%viewDetails"
                        onAction="#handleViewDetails"/>

                <Button text="%MergeTicket"
                        onAction="#handleMerge"/>

            </FlowPane>

        </VBox>

    </content>

</ScrollPane>